# Copy to `.env` (gitignored) and fill in.
#
# RevenueCat's Android SDK key, from the project's Apps page. It is a public
# client key — it identifies the app, not the account — which is why the
# EXPO_PUBLIC_ prefix is correct here. Do not put the secret API key in this
# file; nothing in the app needs it.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
