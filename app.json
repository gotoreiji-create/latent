{
  "expo": {
    "name": "latent",
    "slug": "latent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.latent.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Latent reads only the timestamp and coordinates of your photos.",
          "savePhotosPermission": "Latent does not save photos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-font",
      "./plugins/withDevApplicationIdSuffix",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "2bdad9a9-53d8-4dc7-80eb-d66cf3144ee2"
      }
    },
    "owner": "reijigotoh"
  }
}
